{
  "$schema": "./node_modules/fallow/schema.json",
  // hidden folders that only hold hooks and workflow tests, which fallow skips on its own
  "ignorePatterns": [".claude/**", ".github/**"],
  "entry": [
    // run by node, not imported
    "scripts/**/*",
    "index.ts",
    "electron/preload.ts",
    "electron/splash-preload.ts",
    "client/app.tsx",
    // webpack entry that renders the loading splash html
    "client/htmlGenerator.tsx",
    // vitest alias for the stylesheets
    "client/test/test-utils-style-stub.ts",
    // the website, loaded by the pages built from site/templates
    "site/**",
    // run by Playwright (npm run test:e2e), the helpers they import are reached from there
    "playwright.config.ts",
    "e2e/**/*.spec.ts",
    "e2e/**/*.shots.ts",
    "e2e/**/*.perf.ts"
  ],
  "ignoreDependencies": [
    // webpack loaders, referenced by name in scripts/tooling/config/webpack.config.base.js
    "esbuild-loader",
    "css-loader",
    "sass-loader",
    "style-loader",
    // the fonts of client/components/layout/player-home/PlayerHome.scss
    "@fontsource/open-sans",
    // used by the scripts of the checks (scripts/checks/smoke.js, scripts/release/check-dist.js, scripts/checks/security-scan.js), which run in CI only
    "@electron/asar",
    "@doyensec/electronegativity",
    // augmented by shared/types/csstype.d.ts, installed with the React typings
    "csstype",
    // scripts/release/dist.js takes the toolset of the AppImage from them to put the update information into its runtime; they are the versions that electron-builder
    // brings (a version of our own could differ from the one it uses), and the script fails when their layout changes
    "app-builder-lib",
    "builder-util"
  ],
  "rules": {
    // errors: dead code stops the build
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
    // existing complexity is reported, not blocking, until it is refactored
    "complexity-cyclomatic": "warn",
    "complexity-cognitive": "warn",
    "complexity-crap": "warn"
  },
  "duplicates": {
    // the existing clones stay below the limit, so duplication can not grow
    "threshold": 3.5
  }
}
