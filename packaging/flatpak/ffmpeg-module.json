{
  "name": "ffmpeg",
  "buildsystem": "simple",
  "build-commands": [
    "./configure --prefix=${FLATPAK_DEST} --disable-gpl --disable-nonfree --disable-version3 --disable-autodetect --disable-everything --disable-network --disable-doc --disable-debug --disable-shared --enable-static --disable-ffplay --enable-ffmpeg --enable-ffprobe --enable-protocol=file,pipe --enable-demuxer=mov,ape,wv,aiff,iff,dsf,tta,tak,mpc,mpc8 --enable-decoder=alac,ape,wavpack,pcm_s16be,pcm_s24be,pcm_s32be,pcm_s8,pcm_u8,dsd_lsbf,dsd_msbf,dsd_lsbf_planar,dsd_msbf_planar,tta,tak,mpc7,mpc8 --enable-muxer=wav --enable-encoder=pcm_s16le,pcm_s24le,pcm_s32le --enable-filter=aresample,aformat,anull,abuffer,abuffersink",
    "make -j${FLATPAK_BUILDER_N_JOBS}",
    "install -Dm755 ffmpeg ${FLATPAK_DEST}/ffmpeg/ffmpeg",
    "install -Dm644 COPYING.LGPLv2.1 ${FLATPAK_DEST}/share/licenses/${FLATPAK_ID}/ffmpeg/COPYING.LGPLv2.1",
    "install -Dm644 LICENSE.md ${FLATPAK_DEST}/share/licenses/${FLATPAK_ID}/ffmpeg/LICENSE.md"
  ],
  "sources": [
    {
      "type": "archive",
      "url": "https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz",
      "sha256": "8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e"
    }
  ]
}
