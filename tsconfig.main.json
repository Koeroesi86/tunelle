{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "node20",
    "moduleResolution": "node16",
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": false,
    "outDir": "out",
    "rootDir": ".",
    "sourceMap": true,
    "isolatedModules": false,
    "resolveJsonModule": true
  },
  "include": ["electron", "index.ts", "shared"],
  "exclude": ["electron/**/*.test.ts", "electron/test-database.ts", "electron/test-utility-process.ts", "shared/**/*.test.ts"]
}
